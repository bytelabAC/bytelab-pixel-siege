{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bytelab/pixel-siege",
	"version": "1.1.0",
	"title": "BYTELAB Pixel Siege",
	"category": "widgets",
	"icon": "games",
	"description": "The BYTELAB pull-and-fling physics game: aim, launch and clear every bug.",
	"keywords": [ "game", "bytelab", "pixel", "physics", "angry" ],
	"textdomain": "bytelab-pixel-siege",
	"attributes": {
		"level": { "type": "number", "default": 1 },
		"height": { "type": "number", "default": 640 },
		"sound": { "type": "boolean", "default": true }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": false }
	},
	"editorScript": "file:./editor.js",
	"editorStyle": "file:./editor.css"
}

